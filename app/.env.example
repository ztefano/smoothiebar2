# Copiar este archivo a .env y completar con las credenciales reales.
# Ver docs/SETUP.md para instrucciones paso a paso.

EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Solo necesaria para compilar el mapa en Android (Apple Maps se usa por defecto en iOS)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=tu-google-maps-api-key

# Esquema de deep link usado para volver del checkout de Mercado Pago
EXPO_PUBLIC_APP_SCHEME=choferdereemplazo
